# GalactiLog environment template.
#
# Copy to .env in the same directory as docker-compose.yml, then edit.
#   cp .env.example .env
#
# Docker Compose reads this file for two purposes:
#   1. Interpolation of ${...} placeholders in docker-compose.yml (host paths,
#      postgres credentials).
#   2. env_file for the app service, which passes GALACTILOG_* and PUID/PGID
#      into the container.
#
# Values shown after "default:" are what the application or compose file uses
# when the variable is unset. Optional variables are left commented out.

# =============================================================================
# Required
# =============================================================================

# Admin account password. A brand-new install refuses to start when this is
# unset, no admin user row exists, and no session secret has been generated.
# Minimum 8 characters.
GALACTILOG_ADMIN_PASSWORD=

# Host directory holding your FITS files. Mounted read-only at
# /app/data/fits inside the container. default: ./sample_fits
GALACTILOG_FITS_HOST_PATH=/path/to/your/fits

# Sets the Secure flag on the authentication cookies. Set to false when
# reaching GalactiLog over plain HTTP, for example on a LAN with no TLS.
# Leaving this true over plain HTTP makes login impossible: the browser
# refuses to store the cookies. default: true
GALACTILOG_HTTPS=false

# =============================================================================
# PostgreSQL
# =============================================================================
# These are consumed by compose interpolation. They set the postgres service
# environment and are substituted into GALACTILOG_DATABASE_URL, so the two
# always agree. PostgreSQL only applies user, password and database name when
# it initializes an empty data directory: changing them later has no effect
# until the postgres data volume is deleted.

# GALACTILOG_POSTGRES_USER=galactilog                  # default: galactilog
# GALACTILOG_POSTGRES_PASSWORD=galactilog              # default: galactilog
# GALACTILOG_POSTGRES_DB=galactilog_catalog            # default: galactilog_catalog

# Host directory for the database files. Unset uses the named volume
# postgres_data. default: postgres_data
# GALACTILOG_POSTGRES_DATA_HOST_PATH=/path/to/postgres/data

# =============================================================================
# Paths and permissions
# =============================================================================

# Host directory for generated thumbnails and previews. Must be writable by
# PUID:PGID. Unset uses the named volume thumbnails_data.
# default: thumbnails_data
# GALACTILOG_THUMBNAILS_HOST_PATH=/path/to/thumbnails

# Host user and group ID the in-container galactilog user is remapped to at
# entrypoint time. Set these to the owner of the bind-mounted directories
# above. Find them with `id -u` and `id -g`. default: 1000 / 1000
# PUID=1000
# PGID=1000

# Set to 1 to skip the entrypoint's one-time ownership adjustment of
# /app/data and the recursive chown of /app/data/thumbnails. With this set,
# you are responsible for making those paths writable by PUID:PGID.
# default: 0
# GALACTILOG_SKIP_CHOWN=1

# =============================================================================
# Authentication
# =============================================================================

# Username for the account created from GALACTILOG_ADMIN_PASSWORD. The
# account-creation pass runs on every boot and is keyed on username: changing
# this value later creates a second admin account rather than renaming the
# first. default: admin
# GALACTILOG_ADMIN_USERNAME=admin

# Optional read-only viewer account. Both variables must be set for the
# account to be created. Password minimum 8 characters. default: unset
# GALACTILOG_VIEWER_USERNAME=viewer
# GALACTILOG_VIEWER_PASSWORD=

# Secret used to sign JWT access tokens (HS256). When unset, a random secret
# is generated on first use and persisted to /app/data/.jwt_secret, so
# sessions survive restarts on a single host. Set it explicitly for
# multi-host or multi-instance deployments, or when the data volume is not
# writable. Generate with: openssl rand -hex 32
# default: auto-generated and persisted
# GALACTILOG_JWT_SECRET=

# Access token lifetime in seconds. default: 1800 (30 minutes)
# GALACTILOG_ACCESS_TOKEN_EXPIRY=1800

# Refresh token lifetime in seconds. Users re-login after this period of
# inactivity. default: 604800 (7 days)
# GALACTILOG_REFRESH_TOKEN_EXPIRY=604800

# =============================================================================
# Optional
# =============================================================================

# Bearer token required to read GET /api/metrics. When set, a scraper must
# send `Authorization: Bearer <token>` and the value is compared in constant
# time; requests without it get 401. When unset, the endpoint is
# unauthenticated and access is limited only by the nginx allowlist
# (localhost plus the 10/8, 172.16/12 and 192.168/16 private ranges).
# default: unset
# GALACTILOG_METRICS_TOKEN=

# Comma-separated allowlist of hostnames the N.I.N.A. and Stellarium
# integration endpoints may connect to. Matching is exact and
# case-insensitive on the URL host, after whitespace is trimmed; there is no
# wildcard or suffix matching, and ports are not part of the comparison. A
# host absent from the list is rejected with 400. When unset, any host is
# allowed except loopback, link-local and metadata addresses, which are
# always blocked. default: unset
# GALACTILOG_INTEGRATION_ALLOWED_HOSTS=nina-pc.lan,192.168.1.50

# Number of concurrent Celery worker processes. Raise on machines with spare
# cores to speed up scans; lower it to reduce memory use. default: 4
# GALACTILOG_CELERY_CONCURRENCY=4

# Comma-separated CORS origin allowlist. Not needed in production, where the
# SPA and API are same-origin behind nginx. Set it when running the frontend
# dev server against a separately hosted backend. default: unset
# GALACTILOG_CORS_ORIGINS=http://localhost:3000
