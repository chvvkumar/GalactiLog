    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "vite-plugin-solid": "^2.11.6",
    "vitest": "^3.2.3"
  },
  "dependencies": {
    "@solidjs/router": "^0.16.1",
    "@tanstack/solid-query": "^5.101.2",
    "chart.js": "^4.5.1",
