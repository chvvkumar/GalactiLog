{
  "name": "galactilog-frontend",
  "version": "0.0.0",
  "description": "GalactiLog Frontend",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest run",
